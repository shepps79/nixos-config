#!/usr/bin/env bash
# Format, rebuild, commit the result labelled with its generation.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

host="${1:-$(hostname)}"
# switch activates locally, so only the current host's config is valid here.
if [[ "$host" != "$(hostname)" ]]; then
  echo "refusing to switch '$host' config on '$(hostname)'" >&2
  exit 1
fi

nix fmt >/dev/null
git add -A          # stage the reformatting; flakes only build git-tracked files

echo "NixOS rebuilding $host..."
sudo nixos-rebuild switch --flake ".#$host" |& tee nixos-switch.log || {
  grep --color error nixos-switch.log
  exit 1
}

# Label the commit with the active generation. The current row is the one with
# "current": true in --json output; grepping the table fails because the word
# "current" is only a column header. Fall back to a dated label if jq finds
# nothing so the commit never aborts on an empty message.
if ! git diff --cached --quiet; then
  label="$(nixos-rebuild list-generations --json 2>/dev/null \
    | jq -r 'map(select(.current)) | .[0] // empty | "generation \(.generation) (\(.nixosVersion))"' 2>/dev/null)"
  git commit -m "${label:-rebuild $host $(date +%Y-%m-%d)}"
fi

# Keep only the last few system generations so the generation list -- and, on
# salt, the systemd-boot menu -- don't grow without bound. "+N" keeps the N most
# recent, including the build just activated; fewer generations means fewer
# rollback targets but a bounded /boot and profile. Disk is reclaimed lazily by
# the weekly nix.gc timer (or `sudo nix-collect-garbage` on demand) so switches
# stay fast. Override the count with KEEP_GENERATIONS.
keep="${KEEP_GENERATIONS:-4}"
echo "Trimming system generations to the last $keep..."
sudo nix-env -p /nix/var/nix/profiles/system --delete-generations "+$keep"
