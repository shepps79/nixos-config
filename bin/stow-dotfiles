#!/usr/bin/env bash
# Symlink the dotfiles/ tree into $HOME on this host.
# dotfiles/<app> are per-application stow packages, each mirroring $HOME
# (dotfiles + .config/*). Every subdirectory of dotfiles/ is one package;
# dotfiles/.gitignore stays at the root and is not a package.
# Run from a checkout of this repo on salt or pepper.
#
# Usage: bin/stow-dotfiles [stow-flags]
#   bin/stow-dotfiles         # link every app package into ~
#   bin/stow-dotfiles -R      # restow (re-sync after changes)
#   bin/stow-dotfiles -D      # unstow: remove the symlinks
#   bin/stow-dotfiles -n -v   # dry run, verbose
set -euo pipefail

root="$(dirname "$(readlink -f "$0")")/.."
stowdir="$root/dotfiles"

# Ensure ~/.config exists so stow folds per-app (e.g. ~/.config/nvim) instead
# of turning all of ~/.config into one symlink into the repo.
mkdir -p "$HOME/.config"

# Every subdirectory of dotfiles/ is an application package.
packages=()
for dir in "$stowdir"/*/; do
  packages+=("$(basename "$dir")")
done

stow --dir="$stowdir" --target="$HOME" --verbose "$@" "${packages[@]}"
