#!/usr/bin/env bash
# Update flake inputs, commit the lock file on its own, then rebuild.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

host="${1:-$(hostname)}"
# Check before updating, so a wrong host doesn't leave a lock bump that was never built.
if [[ "$host" != "$(hostname)" ]]; then
  echo "refusing to switch '$host' config on '$(hostname)'" >&2
  exit 1
fi

# omp is pinned to a release tag in flake.nix; move the pin to the newest release.
omp_tag=$(git ls-remote --tags --refs https://github.com/can1357/oh-my-pi \
  | awk -F/ '{print $3}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)
[[ -n "$omp_tag" ]] || { echo "could not find an omp release tag" >&2; exit 1; }
sed -i -E "s|(omp\.url = \"github:can1357/oh-my-pi/)[^\"]+\"|\1${omp_tag}\"|" flake.nix
grep -q "oh-my-pi/${omp_tag}\"" flake.nix || { echo "failed to pin omp to ${omp_tag} in flake.nix" >&2; exit 1; }

nix flake update
# Commit only the flake files so the bump stays separate from whatever rebuild stages.
if ! git diff --quiet -- flake.nix flake.lock; then
  git commit -m "chore(flake): update flake inputs" -- flake.nix flake.lock
fi

exec bin/rebuild "$host"
