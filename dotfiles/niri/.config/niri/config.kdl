// niri config, ported from vimjoyer's wrapped niri (github:vimjoyer/nixconf,
// wrappedPrograms/niri.nix) to plain KDL. niri reloads this file on save.
// Reference: https://niri-wm.github.io/niri/Configuration:-Introduction

prefer-no-csd

input {
    focus-follows-mouse

    keyboard {
        xkb {
            layout "za"
            // vimjoyer also remaps Caps Lock to Escape:
            // options "caps:escape"
        }
        repeat-rate 40
        repeat-delay 250
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    gaps 5

    focus-ring {
        width 2
        active-color "#fe8019"
    }
}

// Named workspaces always exist, so Mod+1..0 jump to fixed slots.
workspace "w0"
workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"
workspace "w6"
workspace "w7"
workspace "w8"
workspace "w9"

// Noctalia draws the wallpaper too (vimjoyer uses swaybg instead).
spawn-at-startup "noctalia-shell"

binds {
    Mod+Return { spawn "kitty"; }
    Mod+S { spawn-sh "noctalia-shell ipc call launcher toggle"; }
    // vimjoyer opens a wlr-which-key app menu here; fuzzel is what salt has.
    Mod+D { spawn "fuzzel"; }

    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+G { fullscreen-window; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+C { center-column; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    Mod+1 { focus-workspace "w0"; }
    Mod+2 { focus-workspace "w1"; }
    Mod+3 { focus-workspace "w2"; }
    Mod+4 { focus-workspace "w3"; }
    Mod+5 { focus-workspace "w4"; }
    Mod+6 { focus-workspace "w5"; }
    Mod+7 { focus-workspace "w6"; }
    Mod+8 { focus-workspace "w7"; }
    Mod+9 { focus-workspace "w8"; }
    Mod+0 { focus-workspace "w9"; }

    Mod+Shift+1 { move-column-to-workspace "w0"; }
    Mod+Shift+2 { move-column-to-workspace "w1"; }
    Mod+Shift+3 { move-column-to-workspace "w2"; }
    Mod+Shift+4 { move-column-to-workspace "w3"; }
    Mod+Shift+5 { move-column-to-workspace "w4"; }
    Mod+Shift+6 { move-column-to-workspace "w5"; }
    Mod+Shift+7 { move-column-to-workspace "w6"; }
    Mod+Shift+8 { move-column-to-workspace "w7"; }
    Mod+Shift+9 { move-column-to-workspace "w8"; }
    Mod+Shift+0 { move-column-to-workspace "w9"; }

    Mod+Ctrl+H { set-column-width "-5%"; }
    Mod+Ctrl+L { set-column-width "+5%"; }
    Mod+Ctrl+J { set-window-height "-5%"; }
    Mod+Ctrl+K { set-window-height "+5%"; }

    Mod+WheelScrollDown { focus-column-left; }
    Mod+WheelScrollUp { focus-column-right; }
    Mod+Ctrl+WheelScrollDown { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp { focus-workspace-up; }

    // Toggle mic mute (vimjoyer uses amixer; wpctl ships with pipewire).
    Mod+V allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%-"; }

    // Screenshots copy to the clipboard (niri's built-in; vimjoyer uses
    // grim/slurp). Mod+Shift+E opens the clipboard image in swappy to annotate.
    Mod+Shift+S { screenshot; }
    Mod+Ctrl+S { screenshot-screen; }
    Mod+Shift+E { spawn-sh "wl-paste | swappy -f -"; }

    // Kept from niri's default config: vimjoyer's desktop has none of these,
    // but a laptop wants them, and without a quit bind there's no way out.
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O repeat=false { toggle-overview; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
    Ctrl+Alt+Delete { quit; }
}
